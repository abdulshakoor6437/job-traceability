{
  "name": "job-hunting-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:worker": "npm --prefix apps/api run worker",
    "dev:web": "npm --prefix apps/web run dev",
    "migrate": "npm --prefix apps/api run migrate",
    "check:dal": "npm --prefix apps/api run check:dal",
    "test:acceptance": "npm --prefix apps/api run test:acceptance",
    "test:redis": "npm --prefix apps/api run test:redis",
    "test:dal-isolation": "npm --prefix apps/api run test:dal-isolation",
    "test:prod-security": "npm --prefix apps/api run test:prod-security",
    "test:offline-auth": "npm --prefix apps/api run test:offline-auth",
    "test:concurrency": "npm --prefix apps/api run test:concurrency",
    "test:heartbeat": "npm --prefix apps/api run test:heartbeat",
    "test:outbox": "npm --prefix apps/api run test:outbox",
    "test:all": "npm --prefix apps/api run test:all",
    "typecheck": "npm --prefix apps/api run typecheck",
    "build": "npm run build --workspaces"
  }
}
