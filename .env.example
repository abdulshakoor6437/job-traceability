# App Configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database Configuration (MySQL 8+ / MariaDB 10.4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_agent_dev
DB_USER=job_agent_user
DB_PASSWORD=your_secure_db_password_here

# Redis Configuration (Background Job Queue Only)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session & Auth Configuration
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_LIFETIME_HOURS=24

# Email Configuration (Console or SMTP)
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM="Job Application Assistant <no-reply@domain.com>"
EMAIL_REPLY_TO=support@domain.com
