# App Configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database Configuration (MySQL 8+ / MariaDB 10.4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_agent_dev
DB_USER=job_agent_user
DB_PASSWORD=your_secure_db_password_here

# Redis Configuration (Background Job Queue Only)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session & Auth Configuration
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_LIFETIME_HOURS=24

# Email Configuration (Console or SMTP)
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM="Job Application Assistant <no-reply@domain.com>"
EMAIL_REPLY_TO=support@domain.com

# LLM Providers — set one or more; fallback order is left-to-right
# Supported names: grok, gemini, openrouter, mock_primary (tests only)
LLM_PROVIDERS=grok,gemini,openrouter

# Grok (xAI) — https://console.x.ai
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-3-mini

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
